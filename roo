#!/usr/bin/env bash
# roo — dev commands for rentroo-lab
set -euo pipefail
cd "$(dirname "$0")"

if [[ -d backend/.venv ]]; then
    export PATH="$PWD/backend/.venv/bin:$PATH"
fi

usage() {
    cat <<'EOF'
usage: ./roo <command>

  test      run backend tests
  lint      ruff check + format check
  serve     run the API with auto-reload (http://localhost:8000)
EOF
}

case "${1:-}" in
    test) cd backend && python -m pytest "${@:2}" ;;
    lint) cd backend && ruff check . && ruff format --check . ;;
    serve) cd backend && uvicorn rentroo.api.app:app --reload "${@:2}" ;;
    "" | help | -h | --help) usage ;;
    *)
        echo "unknown command: $1" >&2
        usage
        exit 1
        ;;
esac
